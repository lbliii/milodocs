{
  "name": "milodocs-theme",
  "version": "4.0.0",
  "description": "Modern documentation theme built on Hugo with Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "hugo server --source exampleSite --port 1313 --buildDrafts --buildFuture",
    "build": "hugo --source exampleSite --minify",
    "watch-css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/dist/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^4.0.0-alpha.26"
  },
  "keywords": [
    "hugo",
    "theme",
    "documentation",
    "tailwindcss"
  ],
  "license": "MIT"
}